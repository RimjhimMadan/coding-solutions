#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int T;
    cin>>T;
    while(T--){
        int N;
        cin>>N;
        int arr[N];
        for(int i=0;i<N;i++){
            cin>>arr[i];
        }
        int sum=0;
        int count1=0;
        int count_1=0;
        for(int i=0;i<N;i++){
            sum+=arr[i];
            if(arr[i]==1) count1++;
            else count_1++;
        }
       if(count1==count_1) cout<<sum<<endl;
      else if(count1>count_1) cout<<sum/2<<endl;
       else if(N%2!=0) cout<<"-1"<<endl;
    }
}
