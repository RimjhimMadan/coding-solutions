#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, K;
        cin >> N >> K;

        vector<int> A(N);

        for (int i = 0; i < N; i++) {
            cin >> A[i];
        }

        int len = N - K;

        int sum = 0;
        for (int i = 0; i < len; i++) {
            sum += A[i];
        }

        int ans = sum;

        for (int i = len; i < N; i++) {
            sum += A[i];
            sum -= A[i - len];

            ans = max(ans, sum);
        }

        cout << ans << endl;
    }

    return 0;
}