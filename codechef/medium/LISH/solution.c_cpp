#include <bits/stdc++.h>
using namespace std;

int main() {
    int N;
    cin >> N;

    long long W;
    cin >> W;

    vector<long long> A(N);

    for (int i = 0; i < N; i++) {
        cin >> A[i];
    }

    vector<long long> weights;

    for (int i = 0; i < N; i++) {
        weights.push_back(A[i]);
        weights.push_back(A[i]);
    }

  
    sort(weights.rbegin(), weights.rend());

    long long total = 0;

    for (int i = 0; i < weights.size(); i++) {
        total += weights[i];

        if (total >= W) {
            cout << i + 1 << endl;
            return 0;
        }
    }

    cout << -1 << endl;

}