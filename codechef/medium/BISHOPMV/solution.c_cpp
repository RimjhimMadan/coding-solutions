#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
    int X1, Y1, X2, Y2;
    cin >> X1 >> Y1 >> X2 >> Y2;

    if (X1 == X2 && Y1 == Y2) {
        cout << 0<<endl;
    }
    else if (X1 + Y1 == X2 + Y2 || X1 - Y1 == X2 - Y2) {
        cout << 1<<endl;
    }
    else if ((X1 + Y1) % 2 != (X2 + Y2) % 2) {
        cout << -1<<endl;  // impossible
    }
    else {
        cout << 2<<endl;
    }
}}
