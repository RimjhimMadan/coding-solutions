#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int N;
        cin>>N;
        string A,B;
        cin>>A>>B;
        int cA=0,cB=0;
        for(int i=0;i<N;i++){
            if(A[i]=='a') cA++;
            if(B[i]=='a') cB++;
        }
        if(cA+cB==N) cout<<"YES"<<endl;
        else cout<<"NO"<<endl;
    }
}
