#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int T;
	cin>>T;
	while(T--){
	    int N;
	    cin>>N;
	    int A[N];
	    int res;
	    for(int i=0;i<N;i++){
	        cin>>A[i];
	        
	    }
	    res=abs(A[0]);
	    for(int i=1;i<N;i++){
	        res=res+abs(A[i]+A[i-1]);
	    }
	    res+=abs(A[N-1]);
	    cout<<res/2<<endl;
	}

}
