#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int N;
    cin>>N;
    int A[N];
   
    for(int i=0;i<N;i++){
        cin>>A[i];
        
    }
     int X;
    cin>>X;
    int c=0,idx=0;
    for(int i=0;i<N;i++){
        if(X==A[i]) {idx=i;
            c++;
        }
        
    }
    if(c==1) cout<<"-2";
    else if(c==0) cout<<"-1";
    else cout<<idx;
}
