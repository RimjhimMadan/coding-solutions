#include <bits/stdc++.h>
using namespace std;

int main() {
    int N;
    cin >> N;

    int A[N];

    // Input array
    for (int i = 0; i < N; i++) {
        cin >> A[i];
    }

    // Input X
    int X;
    cin >> X;

    int c = 0;

    for (int i = 0; i < N; i++) {
        if (A[i] == X) {
            c++;

            if (c == 2) {
                cout << i;
                return 0;
            }
        }
    }

    if (c == 0)
        cout << -1;
    else
        cout << -2;

    return 0;
}