#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    unordered_map<long long,int>f;
	    for(int i=0;i<n;i++){
	        long long x;
	        cin>>x;
	        f[x]++;
	    }
	    int maxf=0;
	    for(auto p:f){
	        maxf=max(maxf,p.second);
	    }
	    cout<<(maxf+1)/2<<endl;
	}

}
